# Copy this file to `.env` in apps/driver/ (gitignored). Expo/Metro automatically
# inlines any var prefixed EXPO_PUBLIC_ into the JS bundle — no extra
# react-native-dotenv setup needed (SDK 49+). See apps/driver/app.config.ts for
# the fallback values used when this file is absent (same public Supabase
# project apps/web and apps/mobile use, so local dev works out of the box).

# Supabase (same provisioned project as apps/web/apps/mobile — project ref modkhbmopyraankxtcfk)
EXPO_PUBLIC_SUPABASE_URL=https://modkhbmopyraankxtcfk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1vZGtoYm1vcHlyYWFua3h0Y2ZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxODEzMzQsImV4cCI6MjEwMTc1NzMzNH0.6w_5ZmhBgmUQIKr7Q7_vBZ2M7pmFUmA0DcSADTGj2-8

# REST API base URL — the driver app hits the same apps/web REST API (/api/valet/**,
# /api/reservations/**, /api/queue/**) that the web /valet portal uses, just
# authenticated via Authorization: Bearer <token> instead of cookies. Leave as-is to
# hit `npm run dev:web` (localhost:3000). For a physical device on the same LAN, use
# your machine's LAN IP instead of localhost, e.g. EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
