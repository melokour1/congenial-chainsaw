# Copy this file to `.env` in apps/mobile/ (gitignored). Expo/Metro automatically
# inlines any var prefixed EXPO_PUBLIC_ into the JS bundle — no extra
# react-native-dotenv setup needed (SDK 49+). See apps/mobile/app.config.ts for
# the fallback values used when this file is absent (same public Supabase
# project the web app uses, so local dev works out of the box).

# Supabase (same provisioned project as apps/web — project ref modkhbmopyraankxtcfk)
EXPO_PUBLIC_SUPABASE_URL=https://modkhbmopyraankxtcfk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1vZGtoYm1vcHlyYWFua3h0Y2ZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxODEzMzQsImV4cCI6MjEwMTc1NzMzNH0.6w_5ZmhBgmUQIKr7Q7_vBZ2M7pmFUmA0DcSADTGj2-8

# REST API base URL — mirrors apps/web's NEXT_PUBLIC_SITE_URL pattern.
# Point this at a deployed apps/web instance, or leave as-is to hit
# `npm run dev:web` (localhost:3000) from a simulator. For a physical device
# on the same LAN, use your machine's LAN IP instead of localhost, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
