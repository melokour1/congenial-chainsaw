// LAXValetCare — canonical data model
// Applied to Supabase Postgres (project ref: modkhbmopyraankxtcfk) via SQL migration
// (see packages/database/migrations/0001_init.sql). This file is the source of truth
// for the shape of the data and for generating a Prisma Client once a direct
// DATABASE_URL (with DB password from the Supabase dashboard → Settings → Database)
// is available in .env. Until then, the Next.js app talks to Supabase over
// @supabase/supabase-js using the same table/column names defined here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VALET
  ADMIN
}

enum ValetQueueStatus {
  AVAILABLE
  BUSY
  BREAK
  OFF
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum RentalClass {
  ECONOMY
  STANDARD
  SUV
  PREMIUM
  LUXURY
  VAN
}

enum FleetStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ServiceTier {
  STANDARD
  VIP_EXPRESS
  VIP_ELITE
}

enum OriginType {
  LAX
  JSX
  ATLANTIC_AVIATION
}

enum ReservationStatus {
  CONFIRMED
  LIVE
  CHECKED_IN
  IN_TRIP
  RETURN_REQUESTED
  DELIVERING
  DELIVERED_PENDING_CLOSE
  CLOSED
  CANCELLED
  UPDATED
}

enum CustomerEtaBand {
  UNDER_15
  MIN_15_30
  MIN_30_45
  PLUS_45
}

enum AddOnType {
  HAND_WASH
  FULL_DETAIL
  EV_CHARGE
  GAS_FILL_UP
}

enum AddOnStatus {
  PENDING
  COMPLETE
}

enum PhotoStage {
  PICKUP
  RETURN
  ADDON
  RENTAL_PICKUP
  RENTAL_RETURN
}

enum DeliveryMethod {
  LOT
  LAX
  HOME
}

enum RentalStatus {
  PENDING_VERIFICATION
  PENDING_INSURANCE
  READY
  PICKED_UP
  RETURNED
  OVERDUE
  CLOSED
  CANCELLED
}

enum InsuranceOption {
  OWN
  LAXVALETCARE_PLAN
}

enum InsurancePlanTier {
  BASIC
  STANDARD
  PREMIUM
}

enum InsuranceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OverdueStage {
  NONE
  T2H
  T24H
  T48H
  T72H
}

enum FaceMatchStatus {
  PENDING
  MATCHED
  FAILED
  MANUAL_REVIEW
}

enum DiscountType {
  PERCENT
  FIXED_CENTS
  FREE_SERVICE
}

enum ChatStatus {
  AI
  HUMAN_REQUESTED
  HUMAN_ACTIVE
  CLOSED
}

enum ChatSender {
  AI
  CUSTOMER
  ADMIN
}

enum JobOfferType {
  DEPARTURE
  RETURN_STAGE1
  RETURN_STAGE2
}

enum OfferResponse {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ────────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────────

/// Mirrors auth.users (Supabase Auth). id == auth.users.id
model Profile {
  id            String   @id
  role          UserRole
  fullName      String
  email         String   @unique
  phone         String?
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── valet-only fields ──
  valetStatus     ValetQueueStatus?
  queuePosition   Int?
  clockedInAt     DateTime?
  sessionExpiresAt DateTime?

  // relations
  savedVehicles          Vehicle[]            @relation("CustomerVehicles")
  reservationsAsCustomer Reservation[]        @relation("CustomerReservations")
  departureJobs          Reservation[]        @relation("DepartureValet")
  returnJobs             Reservation[]        @relation("ReturnValet")
  rentalBookings         RentalBooking[]      @relation("CustomerRentals")
  rentalVerification     RentalVerification?
  photosTaken            Photo[]              @relation("PhotoTakenBy")
  activityLogs           ActivityLog[]        @relation("ActivityActor")
  notifications          Notification[]
  chatThreads            ChatThread[]         @relation("CustomerChats")
  chatMessagesSent       ChatMessage[]        @relation("AdminChatMessages")
  jobOffers              JobOffer[]

  @@index([role])
  @@map("profiles")
}

// ────────────────────────────────────────────────────────────────────────────
// Terminal directory
// ────────────────────────────────────────────────────────────────────────────

model Terminal {
  id             String   @id @default(cuid())
  code           String   @unique // "1".."8","B","JSX","ATLANTIC"
  name           String
  isOffSite      Boolean  @default(false)
  offSiteAddress String?
  isClosed       Boolean  @default(false) // Terminal 5, closed until 2028
  closedNote     String?
  note           String?  // e.g. Delta One check-in note, bus-to-West-Gates warning
  airlines       Airline[]
  reservations   Reservation[]

  @@map("terminals")
}

model Airline {
  id         String   @id @default(cuid())
  name       String
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  @@index([terminalId])
  @@map("airlines")
}

// ────────────────────────────────────────────────────────────────────────────
// Vehicles
// ────────────────────────────────────────────────────────────────────────────

/// A customer's own car, used for valet bookings
model Vehicle {
  id           String        @id @default(cuid())
  ownerId      String?
  owner        Profile?      @relation("CustomerVehicles", fields: [ownerId], references: [id])
  color        String
  make         String
  model        String
  transmission Transmission
  plate        String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]

  @@index([ownerId])
  @@map("vehicles")
}

/// Rental fleet inventory
model FleetVehicle {
  id           String          @id @default(cuid())
  class        RentalClass
  make         String
  model        String
  year         Int
  color        String
  plate        String          @unique
  dailyRateCents Int
  photos       String[]
  status       FleetStatus     @default(AVAILABLE)
  mileage      Int             @default(0)
  location     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  rentals      RentalBooking[]

  @@map("fleet_vehicles")
}

// ────────────────────────────────────────────────────────────────────────────
// Valet reservations
// ────────────────────────────────────────────────────────────────────────────

model Reservation {
  id          String   @id @default(cuid())
  bookingCode String   @unique

  customerId String
  customer   Profile  @relation("CustomerReservations", fields: [customerId], references: [id])

  originType     OriginType
  terminalId     String?
  terminal       Terminal?  @relation(fields: [terminalId], references: [id])
  departingAirline       String?
  departingFlightNumber  String?
  returningAirline       String?
  returningFlightNumber  String?
  bagsInfo               String?

  departureDate      DateTime
  returnDateEstimate DateTime

  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleColor String
  vehicleMake  String
  vehicleModel String
  transmission Transmission
  plate        String?
  vehicleLocation String?

  serviceTier   ServiceTier
  addOns        ReservationAddOn[]
  gratuityCents Int      @default(0)

  priceBreakdown Json
  totalCents     Int
  stripePaymentIntentId String?

  status ReservationStatus @default(CONFIRMED)

  departureValetId String?
  departureValet   Profile? @relation("DepartureValet", fields: [departureValetId], references: [id])
  returnValetId    String?
  returnValet      Profile? @relation("ReturnValet", fields: [returnValetId], references: [id])

  customerEtaBand    CustomerEtaBand?
  customerEtaMinutes Int?
  customerOnWayAt    DateTime?

  flightLandedAt    DateTime?
  customerAtCurbAt  DateTime?
  curbLocationDetail String?

  photos       Photo[]
  activityLogs ActivityLog[]
  rating       Rating?
  jobOffers    JobOffer[]
  notifications Notification[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("reservations")
}

model ReservationAddOn {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  type          AddOnType
  priceCents    Int
  status        AddOnStatus @default(PENDING)
  completedAt   DateTime?

  @@index([reservationId])
  @@map("reservation_add_ons")
}

// ────────────────────────────────────────────────────────────────────────────
// Rentals
// ────────────────────────────────────────────────────────────────────────────

model RentalBooking {
  id          String   @id @default(cuid())
  bookingCode String   @unique

  customerId String
  customer   Profile  @relation("CustomerRentals", fields: [customerId], references: [id])

  fleetVehicleId String
  fleetVehicle   FleetVehicle @relation(fields: [fleetVehicleId], references: [id])

  pickupDate      DateTime
  returnDate      DateTime
  deliveryMethod  DeliveryMethod
  deliveryAddress String?

  status RentalStatus @default(PENDING_VERIFICATION)

  insuranceOption          InsuranceOption
  insurancePlan            InsurancePlanTier?
  insuranceStatus          InsuranceStatus    @default(PENDING)
  insuranceRejectionReason String?
  insuranceCardFrontUrl    String?
  insuranceCardBackUrl     String?
  insuranceCompany         String?
  insurancePolicyNumber    String?

  agreementPdfUrl        String?
  agreementSignedAt      DateTime?
  agreementSignatureUrl  String?

  addOns          Json?
  priceBreakdown  Json
  totalCents      Int
  depositHoldCents Int
  stripePaymentIntentId String?

  overdueStage OverdueStage @default(NONE)

  photos        Photo[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("rental_bookings")
}

model RentalVerification {
  id         String  @id @default(cuid())
  customerId String  @unique
  customer   Profile @relation(fields: [customerId], references: [id])

  dlNumber String
  dlState  String
  dlExpiry DateTime
  dlFrontUrl String
  dlBackUrl  String

  dob            DateTime
  fullLegalName  String
  addressStreet  String
  addressUnit    String?
  addressCity    String
  addressState   String
  addressZip     String
  phone          String
  email          String

  emergencyContactName         String
  emergencyContactPhone        String
  emergencyContactRelationship String

  faceMatchStatus   FaceMatchStatus @default(PENDING)
  faceMatchAttempts Int             @default(0)
  verifiedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rental_verifications")
}

// ────────────────────────────────────────────────────────────────────────────
// Photos, activity log, ratings
// ────────────────────────────────────────────────────────────────────────────

model Photo {
  id              String         @id @default(cuid())
  reservationId   String?
  reservation     Reservation?   @relation(fields: [reservationId], references: [id])
  rentalBookingId String?
  rentalBooking   RentalBooking? @relation(fields: [rentalBookingId], references: [id])
  url             String
  stage           PhotoStage
  takenByValetId  String?
  takenByValet    Profile?       @relation("PhotoTakenBy", fields: [takenByValetId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([reservationId])
  @@index([rentalBookingId])
  @@map("photos")
}

model ActivityLog {
  id              String         @id @default(cuid())
  reservationId   String?
  reservation     Reservation?   @relation(fields: [reservationId], references: [id])
  rentalBookingId String?
  rentalBooking   RentalBooking? @relation(fields: [rentalBookingId], references: [id])
  actorId         String?
  actor           Profile?       @relation("ActivityActor", fields: [actorId], references: [id])
  action          String
  detail          Json?
  createdAt       DateTime       @default(now())

  @@index([reservationId])
  @@index([rentalBookingId])
  @@map("activity_logs")
}

model Rating {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  stars         Int
  comment       String?
  tipCents      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@map("ratings")
}

// ────────────────────────────────────────────────────────────────────────────
// Promo codes, notifications, chat
// ────────────────────────────────────────────────────────────────────────────

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String
  discountType  DiscountType
  discountValue Int
  active        Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@map("promo_codes")
}

model Notification {
  id              String         @id @default(cuid())
  profileId       String
  profile         Profile        @relation(fields: [profileId], references: [id])
  title           String
  body            String
  type            String
  reservationId   String?
  reservation     Reservation?   @relation(fields: [reservationId], references: [id])
  rentalBookingId String?
  rentalBooking   RentalBooking? @relation(fields: [rentalBookingId], references: [id])
  sentVia         String[]
  readAt          DateTime?
  createdAt       DateTime       @default(now())

  @@index([profileId])
  @@map("notifications")
}

model ChatThread {
  id            String        @id @default(cuid())
  customerId    String
  customer      Profile       @relation("CustomerChats", fields: [customerId], references: [id])
  status        ChatStatus    @default(AI)
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]

  @@index([customerId])
  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id])
  sender    ChatSender
  adminId   String?
  admin     Profile?   @relation("AdminChatMessages", fields: [adminId], references: [id])
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId])
  @@map("chat_messages")
}

// ────────────────────────────────────────────────────────────────────────────
// Fair queue job dispatch
// ────────────────────────────────────────────────────────────────────────────

model JobOffer {
  id              String         @id @default(cuid())
  reservationId   String?
  reservation     Reservation?   @relation(fields: [reservationId], references: [id])
  rentalBookingId String?
  valetId         String
  valet           Profile        @relation(fields: [valetId], references: [id])
  jobType         JobOfferType
  offeredAt       DateTime       @default(now())
  respondedAt     DateTime?
  response        OfferResponse  @default(PENDING)
  roundNumber     Int            @default(1)

  @@index([reservationId])
  @@index([valetId])
  @@map("job_offers")
}

// ────────────────────────────────────────────────────────────────────────────
// App settings (pricing, tax, service fee, etc. — Admin > Settings)
// ────────────────────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
